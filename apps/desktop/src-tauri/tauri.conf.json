{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anvil",
  "version": "1.0.0",
  "identifier": "io.anvil.vault.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anvil",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  }
}
