# Copy this file to `deploy/.env` and populate all secret fields.
# Generate fresh secrets cleanly with:
#   cargo run --bin anvil-server -- keygen

POSTGRES_DB=anvil
POSTGRES_USER=anvil
POSTGRES_PASSWORD=replace-with-strong-random-postgres-password

ANVIL_PORT=8080
ANVIL_ALLOW_SIGNUPS=false
ANVIL_PUBLIC_URL=https://vault.example.com

# Generated by `anvil-server keygen`:
ANVIL_JWT_PRIVATE_KEY=""
ANVIL_PRELOGIN_SECRET=""
ANVIL_AUTH_PEPPER=""

# Comma-separated CIDR ranges of reverse proxies allowed to pass X-Forwarded-For:
ANVIL_TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12

# Comma-separated browser extension or web client origins allowed via CORS:
ANVIL_CORS_ORIGINS=

# Opt-in SSRF-hardened website favicon proxy (disabled by default):
ANVIL_ENABLE_FAVICON_PROXY=false

ANVIL_LOG_FORMAT=json
